# Retell voice AI
RETELLAI_API_KEY=your-retell-secret-key
NEXT_PUBLIC_RETELL_AGENT_ID=your-retell-agent-id

# Optional, server-only: the Sun Moon Divine Sect's own Retell agent (its own voice). A call
# placed from /sect for NEXT_PUBLIC_RETELL_AGENT_ID dials this agent instead.
# Every /sect call asks the backend for the sect persona either way (metadata
# persona "ming-sect", the id from the sect's first name, the Ming Sect); calls from
# the main page are never changed.
RETELL_SECT_AGENT_ID=

# Optional: dev Retell agent wired to your LOCAL backend. When set, local dev
# probes the dev backend's /ping and dials this agent if it's reachable,
# otherwise falls back to NEXT_PUBLIC_RETELL_AGENT_ID. Ignored in prod builds.
NEXT_PUBLIC_RETELL_AGENT_ID_DEV=

# Optional: dev backend base URL probed to decide dev-vs-prod agent.
# Defaults to the Makefile's ngrok tunnel when unset.
NEXT_PUBLIC_DEV_API_URL=https://conversational.ngrok.app

# Optional: production backend base URL. Pinged at /ping on page load so the
# Cloud Run instance is booting before the visitor starts a call, and the
# target the /api/chat route proxies text chat to (the browser never calls it
# directly). Defaults to the Cloud Run domain when unset. Dev builds' text chat
# prefers the dev backend above whenever it answers /ping.
NEXT_PUBLIC_API_URL=https://portfolio-ws.art3m1s.me

# Optional: lock CORS origin in production
NEXT_PUBLIC_APP_URL=http://localhost:3000
